APP_NAME=AgroGuardian AI
MODEL_VERSION=1.0.0
ENVIRONMENT=development
# Local development fallback
DATABASE_URL=sqlite:///./agroguardian.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/agroguardian?sslmode=require
AUTO_SEED_DEMO=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
API_BASE_URL=http://127.0.0.1:8000
# Full official ESP32 endpoint. In production use https://<public-api>/api/v1/telemetry/esp.
AGROGUARDIAN_API_URL=http://127.0.0.1:8000/api/v1/telemetry/esp
API_PUBLIC_HOSTNAME=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=-23.455
OPENWEATHER_LON=-46.533
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
ENABLE_OVERPASS_GEO=true
GEO_SEARCH_RADIUS_M=3000
DEFAULT_FARM_NAME=Fazenda Modelo
DEFAULT_REGION=Guarulhos - SP
DEFAULT_CLIENT=Cliente Demo
DEFAULT_EQUIPMENT=Trator A
DEFAULT_DEVICE_API_KEY=
ESP32_API_KEY=
ESP32_DEVICE_ID=ESP32-AGRO-001
IOT_AUTH_ENABLED=true
IOT_LIVE_SECONDS=30
IOT_STALE_SECONDS=300
IOT_OFFLINE_THRESHOLD_SECONDS=300
IOT_RATE_LIMIT_PER_MINUTE=120
IOT_MAX_PAYLOAD_BYTES=32768
IOT_MIN_PREDICTION_INTERVAL_SECONDS=0
IOT_TEMPERATURE_MIN_C=-40
IOT_TEMPERATURE_MAX_C=85
IOT_PRESSURE_MIN_HPA=300
IOT_PRESSURE_MAX_HPA=1100
IOT_FUTURE_TIMESTAMP_TOLERANCE_SECONDS=60
IOT_DISTANCE_SAFE_CM=180
IOT_DISTANCE_ATTENTION_CM=180
IOT_DISTANCE_CRITICAL_CM=45
IOT_INCLINATION_ATTENTION_DEG=10
IOT_INCLINATION_HIGH_DEG=15
IOT_INCLINATION_CRITICAL_DEG=22
# Compatibility aliases for older clients.
IOT_OFFLINE_SECONDS=300
OBSTACLE_ATTENTION_CM=180
OBSTACLE_NEAR_CM=80
OBSTACLE_CRITICAL_CM=45
TILT_MODERATE_DEG=10
TILT_HIGH_DEG=15
TILT_EXTREME_DEG=22
ACCELERATION_IMPACT_G=1.8
IOT_ACCELERATION_MAX_M_S2=78.5
IOT_ACCELERATION_SUSPECT_M_S2=70
GYRO_ABNORMAL_DPS=220
HIGH_TEMPERATURE_C=38
HIGH_HUMIDITY_PCT=88
